# ─────────────────────────────────────────────────────────────
#  Staffless: environment variables
#  Copy this file to ".env" and fill in the providers you want to use.
#  With no keys at all the company runs in demo mode (simulated AI).
# ─────────────────────────────────────────────────────────────

# Server
PORT=4747
HOST=127.0.0.1

# Language the AI employees speak (en | tr)
COMPANY_LANGUAGE=en

# Anthropic (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com
OPENAI_API_KEY=

# Google Gemini: https://aistudio.google.com
GEMINI_API_KEY=

# Ollama (local models): https://ollama.com
# Installed models are discovered automatically while Ollama is running.
OLLAMA_HOST=http://127.0.0.1:11434

# Any OpenAI-compatible endpoint (OpenRouter, Groq, LM Studio, vLLM...)
# Used by models with provider: "compat" in config/models.json.
COMPAT_BASE_URL=
COMPAT_API_KEY=

# ── Use your existing subscription instead of an API key ──
# Claude Code (Claude Pro/Max) and Codex CLI (ChatGPT Plus/Pro) are detected
# automatically when installed and logged in:
#   npm i -g @anthropic-ai/claude-code   &&  claude auth login
#   npm i -g @openai/codex               &&  codex login
CLAUDE_CLI=auto            # auto | off
CODEX_CLI=auto             # auto | off
CLAUDE_CLI_PATH=           # optional explicit path to claude(.exe/.cmd)
CODEX_CLI_PATH=            # optional explicit path to codex(.exe/.cmd)
CLI_TIMEOUT_MIN=20         # max minutes per CLI call
# API keys above are hidden from the CLIs so they bill your subscription.
# Set to true to let the CLIs see them (pay-as-you-go billing instead).
CLI_USE_API_KEYS=false

# Force demo mode even when real keys are present (for testing)
FORCE_MOCK=false

# Where company state and generated projects are stored (defaults: ./data, ./workspace)
DATA_DIR=
WORKSPACE_DIR=

# Telegram: send briefs from your phone, get the plan, QA result and the ZIP back.
# Create a bot with @BotFather (/newbot). You can also paste the token in Settings → Telegram.
TELEGRAM_BOT_TOKEN=
# Optional: chat ids allowed without pairing (comma-separated). Otherwise pair with /pair <code>.
TELEGRAM_ALLOWED_CHAT_IDS=
# Only for a self-hosted Bot API server
TELEGRAM_API_BASE=

# Interpreters for free syntax checks and the PHP "Run" button (auto-detected when empty)
PHP_BIN=
# Chrome / Edge / Chromium used by QA's browser check (auto-detected; "off" disables it)
BROWSER_PATH=
PYTHON_BIN=
